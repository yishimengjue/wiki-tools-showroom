        "func bindNamedMapper(bindType int, query string, arg interface{}, m *reflectx.Mapper) (string, []interface{}, error) {",
        "\tt := reflect.TypeOf(arg)",
        "\tk := t.Kind()",
        "\tswitch {",
        "\tcase k == reflect.Map && t.Key().Kind() == reflect.String:",
        "\t\tm, ok := convertMapStringInterface(arg)",
        "\t\tif !ok {",
        "\t\t\treturn \"\", nil, fmt.Errorf(\"sqlx.bindNamedMapper: unsupported map type: %T\", arg)",
        "\t\t}",
        "\t\treturn bindMap(bindType, query, m)",
        "\tcase k == reflect.Array || k == reflect.Slice:",
        "\t\treturn bindArray(bindType, query, arg, m)",
        "\tdefault:",
        "\t\treturn bindStruct(bindType, query, arg, m)",
        "\t}",
        "}"
      ],
